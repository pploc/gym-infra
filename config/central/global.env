# Centralized Infrastructure Configuration for Gym Chain Microservices

# Database Endpoints
POSTGRES_HOST=postgres.gym-system.svc.cluster.local
POSTGRES_PORT=5432
KAFKA_BROKERS=kafka.gym-system.svc.cluster.local:9092
REDIS_HOST=redis.gym-system.svc.cluster.local
REDIS_PORT=6379
CASSANDRA_HOST=cassandra.gym-system.svc.cluster.local
CASSANDRA_PORT=9042
YUGABYTE_HOST=yugabyte.gym-system.svc.cluster.local
YUGABYTE_PORT=5433
SCHEMA_REGISTRY_URL=http://schema-registry.gym-system.svc.cluster.local:8081

# API Gateway & Networking
KONG_GATEWAY_URL=http://kong-gateway.gym-system.svc.cluster.local:8000
METRICS_PORT=9090
LOG_LEVEL=INFO

# Security & Authentication
JWT_ISSUER=gym-identifier
JWT_AUDIENCE=gym-services
